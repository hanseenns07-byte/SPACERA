# ── Contact form email delivery ────────────────────────────────────────────
# The /api/contact route emails inquiries to CONTACT_TO using these SMTP creds.
# For Gmail: enable 2-Step Verification, then create an "App Password"
# (https://myaccount.google.com/apppasswords) and paste the 16-char value below.
# Copy this file to `.env.local` for local dev, and set the same vars in
# Netlify → Site settings → Environment variables for production.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=idspacera@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Where inquiries are delivered (defaults to idspacera@gmail.com if unset)
CONTACT_TO=idspacera@gmail.com
